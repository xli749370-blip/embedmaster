public/audio/

# ---------- 移动端 ----------
# APK 单文件 180MB+，超过 GitHub 100MB 单文件上限；构建方法见 README
*.apk
*.aab
*.jks
*.keystore
android/
ios/

# ---------- 本地验证 / 调试产物 ----------
shot-*.png
hd-*.png
*.log
